rules_version = '2';
// Three areas:
//   uploads/{uid}/**  raw masters from creators (owner write, nobody reads back)
//   p/**              derived FREE panels — public, immutable, CDN cached
//   premium/**        derived PREMIUM panels — no direct access; signed URLs only
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{draftId}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|avif|tiff)');
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    match /p/{file}       { allow read: if true; allow write: if false; }
    match /premium/{file} { allow read, write: if false; }
  }
}
