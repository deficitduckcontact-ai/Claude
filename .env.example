# You normally need NONE of this. Deployed on Firebase Hosting, the site finds
# its Firebase project by itself; on your computer it runs in DEMO mode.
# Only fill these in to host somewhere other than Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Public image CDN base, e.g. https://img.tinycoup.com  (defaults to the storage bucket)
VITE_IMAGE_BASE=
# reCAPTCHA Enterprise site key for App Check (bot protection)
VITE_RECAPTCHA_SITE_KEY=
# Set to "true" to talk to local emulators (npm run emulators)
VITE_USE_EMULATORS=
# Set to "true" to deploy a pure look-and-feel demo (fake accounts)
VITE_FORCE_DEMO=
