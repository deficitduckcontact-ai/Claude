# Leave these empty to run TinyCoup in DEMO MODE: seed comics, accounts and
# checkout are simulated in the browser (localStorage). Fill them in to go live.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Public image CDN base, e.g. https://img.tinycoup.com  (defaults to the storage bucket)
VITE_IMAGE_BASE=
# Set to "true" to talk to local emulators (npm run emulators)
VITE_USE_EMULATORS=
VITE_ALLOW_DEMO=
